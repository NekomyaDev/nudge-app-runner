#!/usr/bin/env python3
"""
Nudge App Installer & Manager
Single-click installer, launcher, and desktop integrator for Nudge (.ndg) applications.
Compliant with FreeDesktop.org (XDG) standards for all Linux desktop environments.
"""

import sys
import os
import re
import shutil
import locale
import subprocess
import argparse
from pathlib import Path

# Paths
HOME = Path.home()
XDG_DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local" / "share"))
NUDGE_APPS_DIR = XDG_DATA_HOME / "nudge" / "apps"
APPLICATIONS_DIR = XDG_DATA_HOME / "applications"
BIN_DIR = HOME / ".local" / "bin"
ICONS_DIR = XDG_DATA_HOME / "icons" / "hicolor" / "scalable" / "apps"
MIME_PACKAGES_DIR = XDG_DATA_HOME / "mime" / "packages"

# ==============================================================================
# Internationalization & Localization (i18n)
# ==============================================================================
def get_system_lang() -> str:
    """Detects current system language from environment and locale."""
    for var in ["LC_ALL", "LC_MESSAGES", "LANG"]:
        val = os.environ.get(var, "")
        if val:
            code = val.split(".")[0].split("_")[0].lower()
            if code in ["tr", "en", "de", "fr", "es", "ru", "ja", "ko", "zh"]:
                return code
    try:
        loc = locale.getdefaultlocale()[0]
        if loc:
            code = loc.split("_")[0].lower()
            if code in ["tr", "en", "de", "fr", "es", "ru", "ja", "ko", "zh"]:
                return code
    except Exception:
        pass
    return "en"

