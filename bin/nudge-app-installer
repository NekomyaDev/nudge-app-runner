SYS_LANG = get_system_lang()
T = TRANSLATIONS.get(SYS_LANG, TRANSLATIONS["en"])

# Default Nudge SVG Icon content if none provided
DEFAULT_NUDGE_SVG = """<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4F46E5"/>
      <stop offset="1" stop-color="#7C3AED"/>
    </linearGradient>
    <linearGradient id="spark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FDE68A"/>
      <stop offset="1" stop-color="#F59E0B"/>
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="112" fill="url(#bg)"/>
  <path d="M148 382 V130 H222 L290 236 V130 H364 V382 H290 L222 276 V382 Z" fill="#FFFFFF"/>
  <circle cx="396" cy="118" r="24" fill="url(#spark)"/>
</svg>"""

def slugify(text: str) -> str:
    s = text.lower().strip()
    s = re.sub(r'[\s_]+', '-', s)
    s = re.sub(r'[^a-z0-9\-]', '', s)
    return s.strip('-') or "nudge-app"

class NdgAppInfo:
    def __init__(self, file_path: Path):
        self.file_path = file_path.resolve()
        self.filename = file_path.name
        self.dir_path = self.file_path.parent
        self.content = ""
        try:
            self.content = self.file_path.read_text(encoding="utf-8", errors="replace")
        except Exception:
            self.content = ""

        self.title = ""
        self.description = ""
        self.version = "1.0.0"
        self.author = ""
        self.effects = set()
        self.is_gui = False
        self.window_title = ""
        self.custom_icon_path = None
        self._parse()

    def _parse(self):
        # 1. Parse comments at top of file
        lines = self.content.splitlines()
        desc_candidates = []
        for line in lines[:30]:
            stripped = line.strip()
            if stripped.startswith("//") or stripped.startswith("#"):
                comment = stripped.lstrip("/# ").strip()
                # Skip file paths (e.g. examples/file-manager/file_manager.ndg)
                if re.search(r'\.(ndg|rs|py|ts|js|json|md)$', comment.lower()) or "/" in comment or "\\" in comment:
                    continue
                # Skip technical badges / compliance tags
                if any(x in comment for x in ["100% Pure", "GATE-01", "Breeze Desktop HIG", "Apache License", "Copyright"]):
                    continue
                if comment.lower().startswith("title:"):
                    self.title = comment.split(":", 1)[1].strip()
                elif comment.lower().startswith("version:"):
                    self.version = comment.split(":", 1)[1].strip()
                elif comment.lower().startswith("author:"):
                    self.author = comment.split(":", 1)[1].strip()
                elif comment.lower().startswith("description:"):
                    desc_candidates.append(comment.split(":", 1)[1].strip())
                elif comment and not any(comment.lower().startswith(x) for x in ["http://", "https://", "nudgec "]):
                    desc_candidates.append(comment)
            elif stripped:
                break

        if desc_candidates:
            self.description = " ".join(desc_candidates)

        # 2. Parse AST / keywords
        win_match = re.search(r'window\s+([A-Za-z0-9_]+)', self.content)
        title_match = re.search(r'title:\s*"([^"]+)"', self.content)
        if title_match:
            self.window_title = title_match.group(1).strip()
            if not self.title:
                self.title = self.window_title

        if re.search(r'\buses\s+[^;{]*\bUI\b', self.content) or win_match or re.search(r'\bview\s+[A-Za-z0-9_]+', self.content) or ".open()" in self.content:
            self.is_gui = True

        # Agent name
        agent_match = re.search(r'agent\s+([A-Za-z0-9_]+)', self.content)
        if not self.title:
            if agent_match:
                name = agent_match.group(1)
                self.title = re.sub(r'([a-z])([A-Z])', r'\1 \2', name)
            else:
                stem = self.file_path.stem
                self.title = stem.replace('-', ' ').replace('_', ' ').title()

        if not self.description:
            if self.is_gui:
                self.description = f"Nudge native desktop application ({self.title})" if SYS_LANG != "tr" else f"Nudge yerel masaüstü uygulaması ({self.title})"
            else:
                self.description = f"Nudge autonomous agent application ({self.title})" if SYS_LANG != "tr" else f"Nudge otonom ajan uygulaması ({self.title})"

        # Effects
        for effect in ["UI", "LLM", "Tool", "IO", "Net", "Computer", "Clock", "Random", "Memory"]:
            if re.search(rf'\buses\s+[^;{{]*\b{effect}\b', self.content):
                self.effects.add(effect)
        if self.is_gui:
            self.effects.add("UI")

        # Custom icon search
        for candidate in ["icon.svg", "icon.png", "logo.svg", "logo.png", "cover.jpg", "avatar.png"]:
            cand_path = self.dir_path / candidate
            if cand_path.is_file():
                self.custom_icon_path = cand_path
                break
            cand_assets = self.dir_path / "assets" / candidate
            if cand_assets.is_file():
                self.custom_icon_path = cand_assets
                break

    @property
    def app_id(self) -> str:
        base = slugify(self.title)
        if not base or base == "nudge-app":
            base = slugify(self.file_path.stem)
        if base.startswith("nudge-"):
            return base
        return f"nudge-{base}"

    @property
    def desktop_file_path(self) -> Path:
        return APPLICATIONS_DIR / f"{self.app_id}.desktop"

    @property
    def installed_app_dir(self) -> Path:
        return NUDGE_APPS_DIR / self.app_id

    @property
    def installed_executable_path(self) -> Path:
        return BIN_DIR / self.app_id

    @property
    def is_installed(self) -> bool:
        return self.desktop_file_path.exists() and self.installed_executable_path.exists()

class NudgeAppManager:
    @staticmethod
    def find_runner() -> str:
        """Locates the nudge-runner executable with fallback locations."""
        script_dir = Path(__file__).resolve().parent
        candidates = [
            script_dir / "nudge-runner",
            BIN_DIR / "nudge-runner",
            Path("/usr/local/bin/nudge-runner"),
            Path("/usr/bin/nudge-runner"),
        ]
        for c in candidates:
            if c.is_file() and os.access(c, os.X_OK):
                return str(c)
        which_path = shutil.which("nudge-runner")
        if which_path:
            return which_path
        return "nudge-runner"

    @staticmethod
    def install(app: NdgAppInfo) -> bool:
        """Installs the .ndg application into standard XDG desktop environment."""
        NUDGE_APPS_DIR.mkdir(parents=True, exist_ok=True)
        APPLICATIONS_DIR.mkdir(parents=True, exist_ok=True)
        BIN_DIR.mkdir(parents=True, exist_ok=True)
        ICONS_DIR.mkdir(parents=True, exist_ok=True)

        target_dir = app.installed_app_dir
        target_dir.mkdir(parents=True, exist_ok=True)

        # 1. Copy source file
        target_file = target_dir / app.filename
        shutil.copy2(app.file_path, target_file)

        # 2. Copy sibling assets if present
        for sibling in ["assets", "traces", "trace.jsonl"]:
            sib_path = app.dir_path / sibling
            if sib_path.exists():
                dest = target_dir / sibling
                if sib_path.is_dir():
                    if dest.exists():
                        shutil.rmtree(dest)
                    shutil.copytree(sib_path, dest)
                else:
                    shutil.copy2(sib_path, dest)

        # 3. Handle Icon
        icon_name = app.app_id
        target_icon = ICONS_DIR / f"{icon_name}.svg"
        if app.custom_icon_path and app.custom_icon_path.suffix.lower() == ".svg":
            shutil.copy2(app.custom_icon_path, target_icon)
        elif app.custom_icon_path and app.custom_icon_path.suffix.lower() == ".png":
            png_dir = XDG_DATA_HOME / "icons" / "hicolor" / "512x512" / "apps"
            png_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(app.custom_icon_path, png_dir / f"{icon_name}.png")
        else:
            target_icon.write_text(DEFAULT_NUDGE_SVG, encoding="utf-8")

        # 4. Create launcher wrapper script in ~/.local/bin
        runner_bin = NudgeAppManager.find_runner()
        wrapper_path = app.installed_executable_path
        wrapper_content = f"""#!/usr/bin/env bash
# Nudge Application Wrapper for {app.title}
APP_FILE="{target_file}"
cd "{target_dir}"
exec "{runner_bin}" "$APP_FILE" --exec "$@"
"""
        wrapper_path.write_text(wrapper_content, encoding="utf-8")
        wrapper_path.chmod(0o755)

        # 5. Create .desktop entry
        terminal_flag = "false" if app.is_gui else "true"
        categories = "Utility;Development;"
        if app.is_gui:
            categories += "GUIDesigner;"

        desktop_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name={app.title}
Comment={app.description}
Exec={wrapper_path} %f
Icon={icon_name}
Terminal={terminal_flag}
Categories={categories}
MimeType=application/x-nudge;
StartupNotify=true
"""
        app.desktop_file_path.write_text(desktop_content, encoding="utf-8")

        # 6. Update desktop database
        try:
            subprocess.run(["update-desktop-database", str(APPLICATIONS_DIR)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        return True

    @staticmethod
    def uninstall(app: NdgAppInfo) -> bool:
        """Completely removes an installed .ndg application."""
        if app.desktop_file_path.exists():
            app.desktop_file_path.unlink()

        if app.installed_executable_path.exists():
            app.installed_executable_path.unlink()

        if app.installed_app_dir.exists():
            shutil.rmtree(app.installed_app_dir)

        # Remove icons
        for ext in [".svg", ".png"]:
            icon_file = ICONS_DIR / f"{app.app_id}{ext}"
            if icon_file.exists():
                icon_file.unlink()

        try:
            subprocess.run(["update-desktop-database", str(APPLICATIONS_DIR)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        return True

    @staticmethod
    def launch(app: NdgAppInfo):
        """Runs the application using nudge-runner detached in its own session."""
        runner_bin = NudgeAppManager.find_runner()
        file_to_run = str(app.file_path)
        if app.is_installed:
            installed_file = app.installed_app_dir / app.filename
            if installed_file.exists():
                file_to_run = str(installed_file)

        env = os.environ.copy()
        # Ensure ~/.local/bin is in PATH so nudgec and tools are found
        env["PATH"] = f"{BIN_DIR}:{env.get('PATH', '')}"

        cmd = [runner_bin, file_to_run, "--exec"]
        subprocess.Popen(cmd, cwd=str(app.dir_path), env=env, start_new_session=True)

    @staticmethod
    def list_installed():
        if not APPLICATIONS_DIR.exists():
            return []
        apps = []
        for dfile in APPLICATIONS_DIR.glob("nudge-*.desktop"):
            if dfile.name == "nudge-app-installer.desktop":
                continue
            content = dfile.read_text(encoding="utf-8", errors="replace")
            name_m = re.search(r'^Name=(.+)$', content, re.MULTILINE)
            exec_m = re.search(r'^Exec=(.+)$', content, re.MULTILINE)
            apps.append({
                "id": dfile.stem,
                "name": name_m.group(1) if name_m else dfile.stem,
                "desktop_file": str(dfile),
                "exec": exec_m.group(1) if exec_m else ""
            })
        return apps

    @staticmethod
    def setup_system():
        APPLICATIONS_DIR.mkdir(parents=True, exist_ok=True)
        MIME_PACKAGES_DIR.mkdir(parents=True, exist_ok=True)
        ICONS_DIR.mkdir(parents=True, exist_ok=True)
        BIN_DIR.mkdir(parents=True, exist_ok=True)

        mime_target = MIME_PACKAGES_DIR / "application-x-nudge.xml"
        mime_content = """<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/x-nudge">
        <comment>Nudge Agent Application</comment>
        <comment xml:lang="tr">Nudge Ajan Uygulaması</comment>
        <icon name="application-x-nudge"/>
        <generic-icon name="application-x-executable"/>
        <glob pattern="*.ndg"/>
        <sub-class-of type="text/plain"/>
    </mime-type>
</mime-info>"""
        mime_target.write_text(mime_content, encoding="utf-8")

        nudge_icon = ICONS_DIR / "nudge.svg"
        mime_icon = ICONS_DIR / "application-x-nudge.svg"
        nudge_icon.write_text(DEFAULT_NUDGE_SVG, encoding="utf-8")
        mime_icon.write_text(DEFAULT_NUDGE_SVG, encoding="utf-8")

        installer_desktop = APPLICATIONS_DIR / "nudge-app-installer.desktop"
        installer_desktop_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name=Nudge App Installer
Name[tr]=Nudge Uygulama Yükleyicisi
Comment=Install and run .ndg Nudge applications
Comment[tr]=.ndg Nudge uygulamalarını sisteme kurun veya doğrudan başlatın
Exec={BIN_DIR}/nudge-app-installer %f
Icon=nudge
Terminal=false
Categories=System;Utility;PackageManager;
MimeType=application/x-nudge;text/x-nudge;
StartupNotify=true
NoDisplay=false
"""
        installer_desktop.write_text(installer_desktop_content, encoding="utf-8")

        subprocess.run(["update-mime-database", str(XDG_DATA_HOME / "mime")], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["update-desktop-database", str(APPLICATIONS_DIR)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["xdg-mime", "default", "nudge-app-installer.desktop", "application/x-nudge"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True


# ==============================================================================
# PyQt6 Modern GUI Implementation
# ==============================================================================
def run_qt_gui(app_info: NdgAppInfo):
    from PyQt6.QtWidgets import (
        QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
        QLabel, QPushButton, QFrame, QMessageBox
    )
    from PyQt6.QtCore import Qt
    from PyQt6.QtGui import QFont

    qt_app = QApplication(sys.argv)
    qt_app.setApplicationName("Nudge App Installer")

    window = QMainWindow()
    window.setWindowTitle(T["window_title"].format(title=app_info.title))
    window.setFixedSize(560, 480)

    window.setStyleSheet("""
        QMainWindow {
            background-color: #12131A;
        }
        QLabel {
            color: #E2E8F0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        QFrame#card {
            background-color: #1E202E;
            border-radius: 12px;
            border: 1px solid #2D3148;
        }
        QPushButton {
            font-family: 'Segoe UI', system-ui, sans-serif;
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 18px;
        }
        QPushButton#btnInstall {
            background-color: #6366F1;
            color: #FFFFFF;
            border: none;
        }
        QPushButton#btnInstall:hover {
            background-color: #4F46E5;
        }
        QPushButton#btnLaunch {
            background-color: #10B981;
            color: #FFFFFF;
            border: none;
        }
        QPushButton#btnLaunch:hover {
            background-color: #059669;
        }
        QPushButton#btnUninstall {
            background-color: #EF4444;
            color: #FFFFFF;
            border: none;
        }
        QPushButton#btnUninstall:hover {
            background-color: #DC2626;
        }
        QPushButton#btnClose {
            background-color: #2D3148;
            color: #94A3B8;
            border: none;
        }
        QPushButton#btnClose:hover {
            background-color: #373C58;
            color: #FFFFFF;
        }
    """)

    central = QWidget()
    window.setCentralWidget(central)
    root_layout = QVBoxLayout(central)
    root_layout.setContentsMargins(24, 24, 24, 24)
    root_layout.setSpacing(16)

    # Header
    header_layout = QHBoxLayout()
    header_layout.setSpacing(16)

    icon_box = QLabel()
    icon_box.setFixedSize(64, 64)
    icon_box.setStyleSheet("background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4F46E5, stop:1 #7C3AED); border-radius: 14px;")
    icon_box.setAlignment(Qt.AlignmentFlag.AlignCenter)
    icon_box.setText("⚡")
    icon_box.setFont(QFont("Segoe UI", 24))
    header_layout.addWidget(icon_box)

    title_layout = QVBoxLayout()
    title_layout.setSpacing(4)
    lbl_title = QLabel(app_info.title)
    lbl_title.setFont(QFont("Segoe UI", 16, QFont.Weight.Bold))
    lbl_title.setStyleSheet("color: #FFFFFF;")
    title_layout.addWidget(lbl_title)

    type_text = T["gui_app"] if app_info.is_gui else T["cli_app"]
    type_color = "#38BDF8" if app_info.is_gui else "#FBBF24"
    lbl_type = QLabel(type_text)
    lbl_type.setFont(QFont("Segoe UI", 11, QFont.Weight.Medium))
    lbl_type.setStyleSheet(f"color: {type_color};")
    title_layout.addWidget(lbl_type)

    header_layout.addLayout(title_layout)
    header_layout.addStretch()
    root_layout.addLayout(header_layout)

    # Info Card
    card = QFrame()
    card.setObjectName("card")
    card_layout = QVBoxLayout(card)
    card_layout.setContentsMargins(16, 16, 16, 16)
    card_layout.setSpacing(12)

    lbl_desc = QLabel(app_info.description)
    lbl_desc.setWordWrap(True)
    lbl_desc.setStyleSheet("color: #CBD5E1; font-size: 13px; line-height: 1.4;")
    card_layout.addWidget(lbl_desc)

    sep = QFrame()
    sep.setFrameShape(QFrame.Shape.HLine)
    sep.setStyleSheet("color: #2D3148;")
    card_layout.addWidget(sep)

    details_layout = QVBoxLayout()
    details_layout.setSpacing(6)

    def add_meta_row(label, val):
        row = QHBoxLayout()
        lbl_k = QLabel(label)
        lbl_k.setFixedWidth(140)
        lbl_k.setStyleSheet("color: #94A3B8; font-size: 12px;")
        lbl_v = QLabel(str(val))
        lbl_v.setStyleSheet("color: #F1F5F9; font-size: 12px;")
        lbl_v.setWordWrap(True)
        row.addWidget(lbl_k)
        row.addWidget(lbl_v, 1)
        details_layout.addLayout(row)

    add_meta_row(T["lbl_source"], app_info.file_path.name)
    add_meta_row(T["lbl_version"], app_info.version)

    status_str = T["status_installed"] if app_info.is_installed else T["status_not_installed"]
    status_color = "#34D399" if app_info.is_installed else "#94A3B8"
    lbl_status_val = QLabel(status_str)
    lbl_status_val.setStyleSheet(f"color: {status_color}; font-size: 12px; font-weight: bold;")
    row_st = QHBoxLayout()
    lbl_st_k = QLabel(T["lbl_status"])
    lbl_st_k.setFixedWidth(140)
    lbl_st_k.setStyleSheet("color: #94A3B8; font-size: 12px;")
    row_st.addWidget(lbl_st_k)
    row_st.addWidget(lbl_status_val, 1)
    details_layout.addLayout(row_st)

    card_layout.addLayout(details_layout)

    # Permissions
    lbl_perm_title = QLabel(T["lbl_permissions"])
    lbl_perm_title.setStyleSheet("color: #94A3B8; font-size: 11px; font-weight: bold; margin-top: 4px;")
    card_layout.addWidget(lbl_perm_title)

    badges_layout = QHBoxLayout()
    badges_layout.setSpacing(8)
    if app_info.effects:
        for eff in sorted(app_info.effects):
            label_text = T["effects"].get(eff, f"⚡ {eff}")
            b = QLabel(label_text)
            b.setStyleSheet("background-color: #282B3E; color: #E2E8F0; border-radius: 6px; padding: 4px 8px; font-size: 11px; border: 1px solid #3B405A;")
            badges_layout.addWidget(b)
    else:
        no_b = QLabel(T["no_permissions"])
        no_b.setStyleSheet("color: #64748B; font-size: 11px;")
        badges_layout.addWidget(no_b)
    badges_layout.addStretch()
    card_layout.addLayout(badges_layout)

    root_layout.addWidget(card)
    root_layout.addStretch()

    # Footer Buttons
    btn_layout = QHBoxLayout()
    btn_layout.setSpacing(10)

    btn_close = QPushButton(T["btn_close"])
    btn_close.setObjectName("btnClose")
    btn_close.clicked.connect(window.close)
    btn_layout.addWidget(btn_close)

    btn_layout.addStretch()

    btn_uninstall = QPushButton(T["btn_uninstall"])
    btn_uninstall.setObjectName("btnUninstall")
    btn_uninstall.setVisible(app_info.is_installed)

    btn_launch = QPushButton(T["btn_launch"])
    btn_launch.setObjectName("btnLaunch")

    btn_install = QPushButton(T["btn_install"])
    btn_install.setObjectName("btnInstall")
    btn_install.setVisible(not app_info.is_installed)

    def do_install():
        try:
            NudgeAppManager.install(app_info)
            lbl_status_val.setText(T["status_installed"])
            lbl_status_val.setStyleSheet("color: #34D399; font-size: 12px; font-weight: bold;")
            btn_install.setVisible(False)
            btn_uninstall.setVisible(True)
            QMessageBox.information(
                window,
                T["dialog_install_title"],
                T["dialog_install_msg"].format(title=app_info.title)
            )
        except Exception as ex:
            QMessageBox.critical(window, T["dialog_error_title"], str(ex))

    def do_uninstall():
        reply = QMessageBox.question(
            window,
            T["dialog_uninstall_confirm_title"],
            T["dialog_uninstall_confirm_msg"].format(title=app_info.title),
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
        )
        if reply == QMessageBox.StandardButton.Yes:
            try:
                NudgeAppManager.uninstall(app_info)
                lbl_status_val.setText(T["status_not_installed"])
                lbl_status_val.setStyleSheet("color: #94A3B8; font-size: 12px; font-weight: bold;")
                btn_install.setVisible(True)
                btn_uninstall.setVisible(False)
                QMessageBox.information(
                    window,
                    T["dialog_uninstall_success_title"],
                    T["dialog_uninstall_success_msg"].format(title=app_info.title)
                )
            except Exception as ex:
                QMessageBox.critical(window, T["dialog_error_title"], str(ex))

    def do_launch():
        try:
            NudgeAppManager.launch(app_info)
            window.close()
        except Exception as ex:
            QMessageBox.critical(window, T["dialog_error_title"], T["dialog_launch_error"].format(err=ex))

    btn_install.clicked.connect(do_install)
    btn_uninstall.clicked.connect(do_uninstall)
    btn_launch.clicked.connect(do_launch)

    btn_layout.addWidget(btn_uninstall)
    btn_layout.addWidget(btn_launch)
    btn_layout.addWidget(btn_install)

    root_layout.addLayout(btn_layout)

    window.show()
    sys.exit(qt_app.exec())


# ==============================================================================
# Tkinter Fallback GUI Implementation
# ==============================================================================
def run_tk_gui(app_info: NdgAppInfo):
    import tkinter as tk
    from tkinter import messagebox

    root = tk.Tk()
    root.title(T["window_title"].format(title=app_info.title))
    root.geometry("540x440")
    root.configure(bg="#1E202E")
    root.resizable(False, False)

    lbl_title = tk.Label(root, text=app_info.title, font=("Helvetica", 16, "bold"), fg="#FFFFFF", bg="#1E202E")
    lbl_title.pack(pady=(20, 4))

    type_text = T["gui_app"] if app_info.is_gui else T["cli_app"]
    lbl_type = tk.Label(root, text=type_text, font=("Helvetica", 10), fg="#38BDF8" if app_info.is_gui else "#FBBF24", bg="#1E202E")
    lbl_type.pack(pady=(0, 15))

    card = tk.Frame(root, bg="#282B3E", padx=16, pady=16)
    card.pack(fill="x", padx=20, pady=5)

    lbl_desc = tk.Label(card, text=app_info.description, font=("Helvetica", 10), fg="#CBD5E1", bg="#282B3E", wraplength=480, justify="left")
    lbl_desc.pack(anchor="w", pady=(0, 10))

    lbl_file = tk.Label(card, text=f"{T['lbl_source']} {app_info.file_path.name}", font=("Helvetica", 9), fg="#94A3B8", bg="#282B3E")
    lbl_file.pack(anchor="w")

    st_txt = f"{T['lbl_status']} {T['status_installed'] if app_info.is_installed else T['status_not_installed']}"
    lbl_status = tk.Label(card, text=st_txt, font=("Helvetica", 9, "bold"), fg="#34D399" if app_info.is_installed else "#94A3B8", bg="#282B3E")
    lbl_status.pack(anchor="w", pady=(4, 0))

    btn_frame = tk.Frame(root, bg="#1E202E", pady=20)
    btn_frame.pack(fill="x", padx=20, side="bottom")

    def tk_install():
        NudgeAppManager.install(app_info)
        messagebox.showinfo(T["dialog_install_title"], T["dialog_install_msg"].format(title=app_info.title))
        root.destroy()

    def tk_launch():
        try:
            NudgeAppManager.launch(app_info)
            root.destroy()
        except Exception as ex:
            messagebox.showerror(T["dialog_error_title"], str(ex))

    def tk_uninstall():
        if messagebox.askyesno(T["dialog_uninstall_confirm_title"], T["dialog_uninstall_confirm_msg"].format(title=app_info.title)):
            NudgeAppManager.uninstall(app_info)
            messagebox.showinfo(T["dialog_uninstall_success_title"], T["dialog_uninstall_success_msg"].format(title=app_info.title))
            root.destroy()

    tk.Button(btn_frame, text=T["btn_close"], command=root.destroy, bg="#3B405A", fg="#FFFFFF", padx=10, pady=5).pack(side="left")

    if app_info.is_installed:
        tk.Button(btn_frame, text=T["btn_uninstall"], command=tk_uninstall, bg="#EF4444", fg="#FFFFFF", padx=10, pady=5).pack(side="right", padx=5)
    else:
        tk.Button(btn_frame, text=T["btn_install"], command=tk_install, bg="#6366F1", fg="#FFFFFF", padx=10, pady=5).pack(side="right", padx=5)

    tk.Button(btn_frame, text=T["btn_launch"], command=tk_launch, bg="#10B981", fg="#FFFFFF", padx=10, pady=5).pack(side="right", padx=5)

    root.mainloop()


# ==============================================================================
# CLI Entrypoint
# ==============================================================================
def main():
    parser = argparse.ArgumentParser(description="Nudge App Installer & Manager for Linux")
    parser.add_argument("file", nargs="?", help="Path to the .ndg application file")
    parser.add_argument("--install", action="store_true", help="Install application non-interactively")
    parser.add_argument("--uninstall", metavar="APP_ID", help="Uninstall an application by ID")
    parser.add_argument("--launch", action="store_true", help="Launch the application directly")
    parser.add_argument("--list", action="store_true", help="List installed Nudge applications")
    parser.add_argument("--setup", action="store_true", help="Register MIME types, desktop file associations, and icons")
    parser.add_argument("--cli", action="store_true", help="Force CLI mode without opening GUI window")

    args = parser.parse_args()

    if args.setup:
        NudgeAppManager.setup_system()
        return

    if args.list:
        installed = NudgeAppManager.list_installed()
        print(f"Installed Nudge Applications ({len(installed)}):")
        for app in installed:
            print(f"  • {app['name']} [{app['id']}] -> {app['exec']}")
        return

    if args.uninstall:
        target_id = args.uninstall
        class DummyInfo:
            app_id = target_id
            desktop_file_path = APPLICATIONS_DIR / f"{target_id}.desktop"
            installed_executable_path = BIN_DIR / target_id
            installed_app_dir = NUDGE_APPS_DIR / target_id
        NudgeAppManager.uninstall(DummyInfo())
        print(f"✓ '{target_id}' uninstalled.")
        return

    if not args.file:
        parser.print_help()
        return

    target_path = Path(args.file)
    if not target_path.exists():
        print(f"Error: file not found: {args.file}", file=sys.stderr)
        sys.exit(1)

    app_info = NdgAppInfo(target_path)

    if args.install:
        NudgeAppManager.install(app_info)
        print(f"✓ '{app_info.title}' installed successfully.")
        return

    if args.launch:
        NudgeAppManager.launch(app_info)
        return

    if args.cli:
        print(f"Title: {app_info.title} (v{app_info.version})")
        print(f"Type: {'GUI' if app_info.is_gui else 'CLI'}")
        print(f"Description: {app_info.description}")
        print(f"Effects: {', '.join(sorted(app_info.effects)) or 'None'}")
        print(f"Installed: {'Yes' if app_info.is_installed else 'No'}")
        return

    try:
        run_qt_gui(app_info)
    except ImportError:
        try:
            run_tk_gui(app_info)
        except ImportError:
            print(f"\n=== {T['window_title'].format(title=app_info.title)} ===")
            print(f"Title: {app_info.title} (v{app_info.version})")
            print(f"Description: {app_info.description}")
            print(f"Type: {'GUI' if app_info.is_gui else 'CLI'}")
            print(f"Status: {T['status_installed'] if app_info.is_installed else T['status_not_installed']}\n")
            ans = input("[I]nstall, [L]aunch, [Q]uit: ").strip().lower()
            if ans in ['i', 'k']:
                NudgeAppManager.install(app_info)
                print("✓ Installed!")
            elif ans in ['l', 'ç']:
                NudgeAppManager.launch(app_info)

if __name__ == "__main__":
    main()
